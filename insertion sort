import time
import random

def insertion_sort_with_metrics(arr):
    """
    Insertion Sort Implementation with Counters for Comparisons and Shifts.
    """
    n = len(arr)
    comparisons = 0
    shifts = 0
    
    for i in range(1, n):
        key = arr[i]
        j = i - 1
        
        while j >= 0:
            comparisons += 1
            if arr[j] > key:
                arr[j + 1] = arr[j]
                shifts += 1
                j -= 1
            else:
                break
        arr[j + 1] = key
        
    return comparisons, shifts

def run_experiments():
    sizes = [100, 500, 1000, 2000, 5000]
    print(f"{'n':<8} | {'Input Type':<15} | {'Comparisons':<12} | {'Shifts':<12} | {'Time (sec)':<10}")
    print("-" * 65)
    
    for n in sizes:
        # Test Cases: Sorted, Reverse Sorted, Random
        test_cases = {
            "Sorted": list(range(n)),
            "Reverse Sorted": list(range(n, 0, -1)),
            "Random": [random.randint(1, 10000) for _ in range(n)]
        }
        
        for name, data in test_cases.items():
            arr_copy = data.copy()
            start_time = time.time()
            comps, shifts = insertion_sort_with_metrics(arr_copy)
            elapsed_time = time.time() - start_time
            
            print(f"{n:<8} | {name:<15} | {comps:<12} | {shifts:<12} | {elapsed_time:<10.6f}")

if __name__ == "__main__":
    run_experiments()    
